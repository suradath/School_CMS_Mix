RewriteEngine On
RewriteBase /

# Redirect Trailing Slashes If Not A Directory...
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# Deny access to sensitive files
<FilesMatch "\.(sql|bak|log|ini|sh|config|php)$">
    Order deny,allow
    Deny from all
</FilesMatch>

# Allow index.php and install.php
<FilesMatch "^(index\.php|install\.php)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Handle Front Controller...
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
